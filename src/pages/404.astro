---
import Layout from '../layouts/Layout.astro';
import { getWhatsAppUrl } from '../config/site';

const whatsappUrl = getWhatsAppUrl();
---

<Layout title="Halaman tidak ditemukan" noindex>
  <section
    class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-6 py-20"
  >
    <p class="text-primary text-sm font-medium">404</p>

    <h1
      class="font-heading mt-4 text-[clamp(2.5rem,6vw,4.5rem)] leading-[0.98] font-medium tracking-[-0.03em] text-balance"
    >
      Ruang ini belum kami tata.
    </h1>

    <p class="text-muted mt-5 max-w-xl text-base leading-relaxed sm:text-lg">
      Halaman yang Anda cari tidak tersedia atau sudah dipindahkan. Mulai lagi
      dari beranda, atau lihat layanan kami.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="bg-primary hover:bg-primary-hover text-on-primary focus-visible:outline-primary rounded-lg px-6 py-3 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        Kembali ke beranda
      </a>

      <a
        href="/services"
        class="border-border text-foreground hover:border-primary hover:text-primary rounded-lg border px-6 py-3 text-sm font-semibold transition-colors"
      >
        Lihat layanan
      </a>

      {
        whatsappUrl && (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-primary inline-flex items-center px-2 py-3 text-sm font-medium transition-colors"
          >
            Chat WhatsApp
          </a>
        )
      }
    </div>
  </section>
</Layout>
