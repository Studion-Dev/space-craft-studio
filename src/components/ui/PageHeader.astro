---
import { Image } from 'astro:assets';
import { ArrowRight, ChevronRight } from '@lucide/astro';
import type { PageHeaderContent } from '../../config/types';

interface Props {
  content: PageHeaderContent;
  class?: string;
}

const { content, class: className } = Astro.props;
const hasImage = Boolean(content.image);
const breadcrumb = content.breadcrumb ?? [];
---

<section
  class:list={[
    'relative overflow-hidden px-4 pt-5 pb-10 sm:px-6 sm:pt-6 lg:px-8 lg:pt-8 lg:pb-12',
    className,
  ]}
>
  <div class="mx-auto max-w-7xl">
    <div class="relative overflow-hidden rounded-3xl">
      {
        hasImage && content.image ? (
          <Image
            src={content.image}
            alt={content.imageAlt ?? ''}
            widths={[640, 960, 1440, 1920]}
            sizes="(min-width: 1280px) 1280px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="h-[240px] w-full object-cover sm:h-[300px] lg:h-[360px]"
          />
        ) : (
          <div class="bg-primary-soft h-[220px] w-full" aria-hidden="true" />
        )
      }

      <div
        class="bg-foreground/10 pointer-events-none absolute inset-0"
        aria-hidden="true"
      >
      </div>
    </div>

    <div
      data-reveal="up"
      class="border-border bg-surface/95 shadow-foreground/5 relative mx-auto -mt-16 max-w-4xl rounded-2xl border px-5 py-7 text-center shadow-xl backdrop-blur-sm sm:-mt-20 sm:px-8 sm:py-9 lg:-mt-24 lg:px-12 lg:py-10"
    >
      {
        breadcrumb.length > 0 && (
          <nav aria-label="Breadcrumb">
            <ol class="text-muted flex flex-wrap items-center justify-center gap-1.5 text-xs">
              {breadcrumb.map((item, index) => (
                <li class="inline-flex items-center gap-1.5">
                  {index > 0 && (
                    <ChevronRight
                      class="text-muted/60 size-3"
                      aria-hidden="true"
                    />
                  )}

                  {item.href ? (
                    <a
                      href={item.href}
                      class="hover:text-primary transition-colors"
                    >
                      {item.label}
                    </a>
                  ) : (
                    <span
                      class="text-foreground font-medium"
                      aria-current="page"
                    >
                      {item.label}
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <p class="text-primary mt-4 text-sm font-medium">{content.eyebrow}</p>

      <h1
        class="font-heading text-foreground mt-3 text-[clamp(2rem,4.6vw,3.65rem)] leading-[1.02] font-medium tracking-[-0.03em] text-balance"
      >
        {content.title}
      </h1>

      <p
        class="text-muted mx-auto mt-4 max-w-2xl text-sm leading-relaxed sm:text-base"
      >
        {content.description}
      </p>

      {
        (content.primaryCta || content.secondaryCta) && (
          <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:items-center">
            {content.primaryCta && (
              <a
                href={content.primaryCta.href}
                class="bg-primary hover:bg-primary-hover focus-visible:outline-primary text-on-primary inline-flex items-center justify-center gap-2 rounded-lg px-5 py-3 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
              >
                {content.primaryCta.label}
                <ArrowRight class="size-4" aria-hidden="true" />
              </a>
            )}

            {content.secondaryCta && (
              <a
                href={content.secondaryCta.href}
                class="border-border bg-card/70 text-foreground hover:border-primary hover:text-primary focus-visible:outline-primary inline-flex items-center justify-center rounded-lg border px-5 py-3 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
              >
                {content.secondaryCta.label}
              </a>
            )}
          </div>
        )
      }

      {
        content.stats && content.stats.length > 0 && (
          <div class="border-border text-muted mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 border-t pt-4 text-xs">
            {content.stats.map((stat) => (
              <span class="inline-flex items-baseline gap-1.5">
                <span class="text-foreground font-semibold">{stat.value}</span>
                <span>{stat.label}</span>
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
