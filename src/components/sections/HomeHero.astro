---
import { Image } from 'astro:assets';
import { ArrowRight, Check } from '@lucide/astro';
import type { HeroContent } from '../../config/types';

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
const { image, imageAlt } = content;
---

<section
  class="relative overflow-hidden px-4 pt-14 pb-16 sm:px-6 sm:pt-16 lg:px-8 lg:pt-10 lg:pb-14"
>
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:items-start lg:gap-8"
  >
    <div class="lg:col-span-7 xl:col-span-6">
      <p
        data-reveal="up"
        class="text-primary text-sm font-medium tracking-[0.01em]"
      >
        {content.eyebrow}
      </p>

      <h1
        data-reveal="up"
        style="transition-delay: 80ms"
        class="font-heading text-foreground mt-5 max-w-4xl text-[clamp(2.75rem,7.2vw,5.75rem)] leading-[0.96] font-medium tracking-[-0.035em] text-balance"
      >
        {content.title}
      </h1>

      <p
        data-reveal="up"
        style="transition-delay: 160ms"
        class="text-muted mt-6 max-w-xl text-base leading-relaxed sm:text-lg"
      >
        {content.description}
      </p>

      <div
        data-reveal="up"
        style="transition-delay: 240ms"
        class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center"
      >
        <a
          href={content.primaryCta.href}
          class="bg-primary hover:bg-primary-hover focus-visible:outline-primary text-on-primary inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          {content.primaryCta.label}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>

        <a
          href={content.secondaryCta.href}
          class="border-border bg-card/60 text-foreground hover:border-primary hover:text-primary focus-visible:outline-primary inline-flex items-center justify-center rounded-lg border px-6 py-3.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          {content.secondaryCta.label}
        </a>
      </div>

      <p
        data-reveal="up"
        style="transition-delay: 320ms"
        class="text-muted mt-5 inline-flex items-center gap-2 text-sm"
      >
        <span
          class="bg-primary-soft text-primary flex size-6 items-center justify-center rounded-full"
          aria-hidden="true"
        >
          <Check class="size-3.5" />
        </span>
        {content.badge}
      </p>

      <div
        data-reveal="up"
        style="transition-delay: 400ms"
        class="border-border mt-10 grid grid-cols-3 gap-4 border-t pt-6 sm:mt-12 lg:mt-8"
      >
        {
          content.stats.map((stat) => (
            <div>
              <p class="font-heading text-foreground text-xl font-medium tracking-tight sm:text-2xl">
                {stat.value}
              </p>
              <p class="text-muted mt-1 text-xs leading-snug sm:text-sm">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="relative lg:col-span-5 lg:mt-8 xl:col-span-6 xl:mt-10">
      <div class="relative mx-auto max-w-md lg:max-w-none">
        <div
          class="bg-accent-soft absolute -inset-3 rotate-1 rounded-[2rem]"
          aria-hidden="true"
        >
        </div>

        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-[4/5] w-full rounded-[1.75rem] object-cover lg:aspect-auto lg:h-[clamp(420px,56vh,560px)]"
        />

        <div
          class="border-border bg-card/95 absolute right-4 -bottom-5 left-4 rounded-xl border p-4 shadow-sm backdrop-blur-sm sm:right-6 sm:left-6"
        >
          <p class="text-muted text-xs">Contoh ruang</p>
          <p class="text-foreground mt-1 text-sm font-medium">
            {content.caption}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
