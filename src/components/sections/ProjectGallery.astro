---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Project, ProjectsPageContent } from '../../config/types';

interface Props {
  content: ProjectsPageContent['detail']['gallery'];
  project: Project;
}

const { content, project } = Astro.props;

const layouts = ['md:col-span-7', 'md:col-span-5 md:mt-12'];

const aspectClasses = ['aspect-[4/3]', 'aspect-[4/3] md:aspect-[4/5]'];
---

<section class="bg-surface-muted px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div data-reveal="up">
      <SectionHeading
        eyebrow={content.eyebrow}
        title={content.title}
        description={content.description}
      />
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-12">
      {
        project.gallery.slice(0, 2).map((image, index) => (
          <figure
            data-reveal="up"
            style={`transition-delay: ${index * 90}ms`}
            class:list={['min-w-0', layouts[index] ?? 'md:col-span-6']}
          >
            <div
              class:list={[
                'border-border bg-surface relative overflow-hidden rounded-2xl border',
                aspectClasses[index] ?? 'aspect-[4/3]',
              ]}
            >
              <Image
                src={image}
                alt={`Detail interior ${project.title} ${index + 1}`}
                widths={[480, 720, 1080]}
                sizes="(min-width: 768px) 55vw, 100vw"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>
