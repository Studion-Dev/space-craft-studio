---
import {
  CalendarDays,
  HardHat,
  Layers,
  Quote,
  ShieldCheck,
} from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { GuaranteeIcon, TestimonialsContent } from '../../config/types';

interface Props {
  content: TestimonialsContent;
}

const { content } = Astro.props;
const [lead, ...rest] = content.items;

const guaranteeIcons: Record<GuaranteeIcon, typeof ShieldCheck> = {
  survey: CalendarDays,
  shield: ShieldCheck,
  material: Layers,
  team: HardHat,
};
---

<section
  id="testimoni"
  class="scroll-mt-24 px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
>
  <div class="mx-auto max-w-7xl">
    <div data-reveal="up">
      <SectionHeading
        eyebrow={content.eyebrow}
        title={content.title}
        description={content.description}
        class="max-w-2xl"
      />
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-12">
      {
        lead && (
          <blockquote
            data-reveal="up"
            class="border-brand-secondary/30 bg-accent-soft flex flex-col justify-between rounded-2xl border p-7 sm:p-10 lg:col-span-7"
          >
            <div>
              <Quote class="text-brand-secondary size-8" aria-hidden="true" />
              <p class="font-heading text-foreground mt-6 text-2xl leading-snug tracking-[-0.015em] sm:text-3xl">
                {lead.quote}
              </p>
            </div>

            <footer class="mt-8">
              <p class="text-foreground text-sm font-semibold">{lead.name}</p>
              <p class="text-muted mt-1 text-xs">{lead.project}</p>
            </footer>
          </blockquote>
        )
      }

      <div class="grid gap-5 lg:col-span-5">
        {
          rest.map((item, index) => (
            <blockquote
              data-reveal="up"
              style={`transition-delay: ${(index + 1) * 80}ms`}
              class="border-border bg-card flex flex-col justify-between rounded-2xl border p-6"
            >
              <p class="text-foreground text-base leading-relaxed">
                {item.quote}
              </p>

              <footer class="border-border mt-6 border-t pt-4">
                <p class="text-foreground text-sm font-semibold">{item.name}</p>
                <p class="text-muted mt-1 text-xs">{item.project}</p>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>

    <div
      class="border-border mt-14 grid gap-6 border-t pt-8 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        content.guarantees.map((item) => {
          const Icon = guaranteeIcons[item.icon];

          return (
            <div class="flex items-start gap-3">
              <span
                class="bg-primary-soft text-primary flex size-9 shrink-0 items-center justify-center rounded-lg"
                aria-hidden="true"
              >
                <Icon class="size-4" />
              </span>

              <div>
                <h3 class="text-foreground text-sm font-semibold">
                  {item.title}
                </h3>
                <p class="text-muted mt-1 text-xs leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
