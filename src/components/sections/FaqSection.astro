---
import { ChevronDown } from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { ServicesContent } from '../../config/types';

interface Props {
  content: ServicesContent['faq'];
}

const { content } = Astro.props;
---

<section id="faq" class="scroll-mt-24 px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
  <div class="mx-auto max-w-3xl">
    <div data-reveal="up">
      <SectionHeading
        eyebrow={content.eyebrow}
        title={content.title}
        description={content.description}
        align="center"
      />
    </div>

    <div class="divide-border border-border mt-10 divide-y border-y">
      {
        content.items.map((item, index) => (
          <details
            class="group"
            data-reveal="up"
            style={`transition-delay: ${index * 45}ms`}
          >
            <summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left text-base font-medium [&::-webkit-details-marker]:hidden">
              <span>{item.question}</span>

              <ChevronDown
                class="text-muted size-5 shrink-0 transition-transform duration-200 group-open:rotate-180"
                aria-hidden="true"
              />
            </summary>

            <p class="text-muted pb-5 text-sm leading-relaxed">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
