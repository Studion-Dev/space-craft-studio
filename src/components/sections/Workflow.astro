---
import SectionHeading from '../ui/SectionHeading.astro';
import type { ServicesContent } from '../../config/types';

interface Props {
  content: ServicesContent['workflow'];
}

const { content } = Astro.props;
---

<section id="alur" class="scroll-mt-24 px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div data-reveal="up">
      <SectionHeading
        eyebrow={content.eyebrow}
        title={content.title}
        description={content.description}
        class="max-w-2xl"
      />
    </div>

    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
      {
        content.steps.map((step, index) => (
          <li
            data-reveal="up"
            style={`transition-delay: ${index * 70}ms`}
            class="border-border relative border-l pl-5 lg:border-t lg:border-l-0 lg:pt-7 lg:pl-0"
          >
            <span class="font-heading text-primary block text-2xl leading-none font-medium">
              {step.step}
            </span>

            <h3 class="font-heading text-foreground mt-3 text-xl leading-tight font-medium tracking-[-0.015em]">
              {step.title}
            </h3>

            <p class="text-muted mt-3 text-sm leading-relaxed">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
