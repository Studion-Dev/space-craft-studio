---
import { ArrowRight } from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { CtaBannerContent } from '../../config/types';

interface Props {
  content: CtaBannerContent;
  class?: string;
}

const { content, class: className } = Astro.props;
---

<section class:list={['px-4 py-16 sm:px-6 lg:px-8 lg:py-20', className]}>
  <div class="mx-auto max-w-7xl">
    <div
      data-reveal="up"
      class="border-brand-secondary/30 bg-accent-soft rounded-3xl border px-6 py-9 sm:px-10 sm:py-11 lg:px-14 lg:py-14"
    >
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <SectionHeading
            eyebrow={content.eyebrow}
            title={content.title}
            description={content.description}
            class="max-w-3xl"
          />
        </div>

        <div
          class="flex flex-col gap-3 sm:flex-row lg:col-span-4 lg:justify-end"
        >
          <a
            href={content.primaryCta.href}
            class="bg-primary hover:bg-primary-hover focus-visible:outline-primary text-on-primary inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            {content.primaryCta.label}
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>

          {
            content.secondaryCta && (
              <a
                href={content.secondaryCta.href}
                class="border-border bg-card/60 text-foreground hover:border-primary hover:text-primary inline-flex items-center justify-center rounded-lg border px-6 py-3.5 text-sm font-semibold transition-colors"
              >
                {content.secondaryCta.label}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
