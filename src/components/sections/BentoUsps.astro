---
import { Image } from 'astro:assets';
import { Boxes, Clock, Layers, Ruler, ShieldCheck } from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { BentoContent, UspIcon } from '../../config/types';

interface Props {
  content: BentoContent;
}

const { content } = Astro.props;
const { image, imageAlt } = content;

const icons: Record<UspIcon, typeof Boxes> = {
  storage: Boxes,
  shield: ShieldCheck,
  layers: Layers,
  ruler: Ruler,
  clock: Clock,
};

const layouts = [
  'lg:col-span-5 lg:row-span-2',
  'lg:col-span-4',
  'lg:col-span-4',
  'lg:col-span-6',
  'lg:col-span-6',
];

const toneStyles = {
  default: {
    card: 'border-border bg-card',
    icon: 'bg-primary-soft text-primary',
    title: 'text-foreground',
    description: 'text-muted',
    titleSize: 'text-lg sm:text-xl',
  },
  primary: {
    card: 'border-primary bg-primary',
    icon: 'bg-on-primary/10 text-on-primary',
    title: 'text-on-primary',
    description: 'text-on-primary/85',
    titleSize: 'text-2xl sm:text-3xl',
  },
  accent: {
    card: 'border-brand-secondary/30 bg-accent-soft',
    icon: 'bg-card/70 text-primary',
    title: 'text-foreground',
    description: 'text-muted',
    titleSize: 'text-lg sm:text-xl',
  },
} as const;
---

<section
  id="keunggulan"
  class="scroll-mt-24 px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
>
  <div class="mx-auto max-w-7xl">
    <div data-reveal="up">
      <SectionHeading
        eyebrow={content.eyebrow}
        title={content.title}
        description={content.description}
      />
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-12">
      {
        content.items.slice(0, 2).map((item, index) => {
          const Icon = icons[item.icon];
          const tone = toneStyles[item.tone ?? 'default'];

          return (
            <article
              data-reveal="up"
              class:list={[
                'flex flex-col justify-between gap-8 rounded-2xl border p-6 sm:p-7',
                tone.card,
                layouts[index],
              ]}
            >
              <span
                class:list={[
                  'flex size-10 items-center justify-center rounded-xl',
                  tone.icon,
                ]}
                aria-hidden="true"
              >
                <Icon class="size-5" />
              </span>

              <div>
                <h3
                  class:list={[
                    'font-heading leading-tight tracking-[-0.02em]',
                    tone.title,
                    tone.titleSize,
                  ]}
                >
                  {item.title}
                </h3>
                <p
                  class:list={[
                    'mt-3 text-sm leading-relaxed',
                    tone.description,
                  ]}
                >
                  {item.description}
                </p>
              </div>
            </article>
          );
        })
      }

      <figure
        class="border-border bg-surface-muted relative aspect-[4/3] overflow-hidden rounded-2xl border lg:col-span-3 lg:row-span-2 lg:aspect-auto"
      >
        <Image
          src={image}
          alt={imageAlt}
          widths={[360, 540, 720]}
          sizes="(min-width: 1024px) 300px, 100vw"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />

        <div
          class="bg-accent-soft/30 pointer-events-none absolute inset-0 mix-blend-multiply"
          aria-hidden="true"
        >
        </div>
      </figure>

      {
        content.items.slice(2).map((item, offset) => {
          const index = offset + 2;
          const Icon = icons[item.icon];
          const tone = toneStyles[item.tone ?? 'default'];

          return (
            <article
              data-reveal="up"
              style={`transition-delay: ${offset * 80}ms`}
              class:list={[
                'flex flex-col justify-between gap-8 rounded-2xl border p-6 sm:p-7',
                tone.card,
                layouts[index],
              ]}
            >
              <span
                class:list={[
                  'flex size-10 items-center justify-center rounded-xl',
                  tone.icon,
                ]}
                aria-hidden="true"
              >
                <Icon class="size-5" />
              </span>

              <div>
                <h3
                  class:list={[
                    'font-heading leading-tight tracking-[-0.02em]',
                    tone.title,
                    tone.titleSize,
                  ]}
                >
                  {item.title}
                </h3>
                <p
                  class:list={[
                    'mt-3 text-sm leading-relaxed',
                    tone.description,
                  ]}
                >
                  {item.description}
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
