---
import { Check } from '@lucide/astro';
import type { Project, ProjectsPageContent } from '../../config/types';

interface Props {
  content: ProjectsPageContent['detail'];
  project: Project;
}

const { content, project } = Astro.props;
---

<section class="px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7" data-reveal="up">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="border-border bg-surface-muted rounded-2xl border p-6">
          <h2
            class="font-heading text-foreground text-xl font-medium tracking-[-0.015em]"
          >
            {content.challenge.challengeTitle}
          </h2>
          <p class="text-muted mt-3 text-sm leading-relaxed">
            {project.challenge}
          </p>
        </div>

        <div class="bg-primary text-on-primary rounded-2xl p-6">
          <h2 class="font-heading text-xl font-medium tracking-[-0.015em]">
            {content.challenge.solutionTitle}
          </h2>
          <p class="text-on-primary/85 mt-3 text-sm leading-relaxed">
            {project.solution}
          </p>
        </div>
      </div>
    </div>

    <div class="lg:col-span-5" data-reveal="up">
      <div
        class="border-border grid gap-8 border-t pt-6 sm:grid-cols-2 lg:grid-cols-1"
      >
        <div>
          <h2 class="text-foreground text-sm font-semibold">
            {content.featuresTitle}
          </h2>
          <ul class="mt-3 space-y-2">
            {
              project.features.map((feature) => (
                <li class="text-muted flex items-start gap-2 text-sm leading-relaxed">
                  <Check
                    class="text-primary mt-0.5 size-4 shrink-0"
                    aria-hidden="true"
                  />
                  <span>{feature}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="border-border border-t pt-6 sm:border-t-0 sm:pt-0 lg:border-t lg:pt-6"
        >
          <h2 class="text-foreground text-sm font-semibold">
            {content.materialsTitle}
          </h2>
          <ul class="mt-3 space-y-2">
            {
              project.materials.map((material) => (
                <li class="text-muted flex items-start gap-2 text-sm leading-relaxed">
                  <Check
                    class="text-primary mt-0.5 size-4 shrink-0"
                    aria-hidden="true"
                  />
                  <span>{material}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
