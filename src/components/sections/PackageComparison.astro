---
import { Check } from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { formatRupiah } from '../../lib/format';
import type { ServicesContent } from '../../config/types';

interface Props {
  content: ServicesContent['packages'];
}

const { content } = Astro.props;
---

<section
  id="paket"
  class="bg-surface-muted scroll-mt-24 px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
>
  <div class="mx-auto max-w-7xl">
    <div data-reveal="up">
      <SectionHeading
        eyebrow={content.eyebrow}
        title={content.title}
        description={content.description}
        class="max-w-2xl"
      />
    </div>

    <div class="mt-12 hidden lg:block" data-reveal="up">
      <table class="w-full table-fixed border-separate border-spacing-0">
        <caption class="sr-only">
          Perbandingan paket layanan SpaceCraft Studio
        </caption>

        <thead>
          <tr>
            <th class="border-border w-40 border-b p-5 text-left align-top">
              <span class="sr-only">Atribut paket</span>
            </th>

            {
              content.items.map((item) => (
                <th
                  class:list={[
                    'border-border border-b p-5 text-left align-top',
                    item.isPopular && 'bg-primary-soft',
                  ]}
                >
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="font-heading text-foreground text-xl leading-tight font-medium">
                      {item.name}
                    </p>
                    {item.isPopular && (
                      <span class="bg-primary text-on-primary rounded-full px-2.5 py-1 text-[10px] font-semibold">
                        Paling populer
                      </span>
                    )}
                  </div>
                  <p class="text-muted mt-2 text-sm leading-relaxed">
                    {item.tagline}
                  </p>
                </th>
              ))
            }
          </tr>
        </thead>

        <tbody>
          <tr>
            <th
              scope="row"
              class="border-border text-muted border-b p-5 text-left align-top text-sm font-medium"
            >
              {content.priceLabel}
            </th>
            {
              content.items.map((item) => (
                <td
                  class:list={[
                    'border-border border-b p-5 align-top',
                    item.isPopular && 'bg-primary-soft',
                  ]}
                >
                  <p class="font-heading text-foreground text-2xl font-medium tracking-tight">
                    {formatRupiah(item.basePricePerSqm)}
                  </p>
                  <p class="text-muted mt-1 text-xs">per m²</p>
                </td>
              ))
            }
          </tr>

          <tr>
            <th
              scope="row"
              class="border-border text-muted border-b p-5 text-left align-top text-sm font-medium"
            >
              {content.bestForLabel}
            </th>
            {
              content.items.map((item) => (
                <td
                  class:list={[
                    'border-border text-muted border-b p-5 align-top text-sm leading-relaxed',
                    item.isPopular && 'bg-primary-soft',
                  ]}
                >
                  {item.bestFor}
                </td>
              ))
            }
          </tr>

          <tr>
            <th
              scope="row"
              class="border-border text-muted border-b p-5 text-left align-top text-sm font-medium"
            >
              {content.durationLabel}
            </th>
            {
              content.items.map((item) => (
                <td
                  class:list={[
                    'border-border text-muted border-b p-5 align-top text-sm',
                    item.isPopular && 'bg-primary-soft',
                  ]}
                >
                  {item.duration}
                </td>
              ))
            }
          </tr>

          <tr>
            <th
              scope="row"
              class="border-border text-muted border-b p-5 text-left align-top text-sm font-medium"
            >
              {content.includesLabel}
            </th>
            {
              content.items.map((item) => (
                <td
                  class:list={[
                    'border-border border-b p-5 align-top',
                    item.isPopular && 'bg-primary-soft',
                  ]}
                >
                  <ul class="space-y-2.5">
                    {item.features.map((feature) => (
                      <li class="text-muted flex items-start gap-2 text-sm leading-relaxed">
                        <Check
                          class="text-primary mt-0.5 size-4 shrink-0"
                          aria-hidden="true"
                        />
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </td>
              ))
            }
          </tr>

          <tr>
            <th class="p-5"></th>
            {
              content.items.map((item) => (
                <td class:list={['p-5', item.isPopular && 'bg-primary-soft']}>
                  <a
                    href="#booking"
                    class="border-border bg-card text-foreground hover:border-primary hover:text-primary inline-flex w-full items-center justify-center rounded-lg border px-4 py-2.5 text-sm font-semibold transition-colors"
                  >
                    {content.ctaLabel}
                  </a>
                </td>
              ))
            }
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-10 grid gap-4 lg:hidden">
      {
        content.items.map((item) => (
          <article
            data-reveal="up"
            class:list={[
              'border-border bg-card rounded-2xl border p-6',
              item.isPopular && 'border-primary',
            ]}
          >
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-heading text-foreground text-xl font-medium">
                {item.name}
              </h3>
              {item.isPopular && (
                <span class="bg-primary text-on-primary rounded-full px-2.5 py-1 text-[10px] font-semibold">
                  Paling populer
                </span>
              )}
            </div>

            <p class="text-muted mt-2 text-sm leading-relaxed">
              {item.tagline}
            </p>

            <p class="font-heading text-foreground mt-5 text-2xl font-medium tracking-tight">
              {formatRupiah(item.basePricePerSqm)}
              <span class="text-muted font-sans text-xs font-normal">/m²</span>
            </p>

            <dl class="border-border mt-5 space-y-3 border-t pt-4 text-sm">
              <div>
                <dt class="text-muted text-xs">{content.bestForLabel}</dt>
                <dd class="text-foreground mt-1 leading-relaxed">
                  {item.bestFor}
                </dd>
              </div>
              <div>
                <dt class="text-muted text-xs">{content.durationLabel}</dt>
                <dd class="text-foreground mt-1">{item.duration}</dd>
              </div>
            </dl>

            <p class="text-muted mt-5 text-xs font-medium">
              {content.includesLabel}
            </p>
            <ul class="mt-2 space-y-2">
              {item.features.map((feature) => (
                <li class="text-muted flex items-start gap-2 text-sm leading-relaxed">
                  <Check
                    class="text-primary mt-0.5 size-4 shrink-0"
                    aria-hidden="true"
                  />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href="#booking"
              class="bg-primary hover:bg-primary-hover text-on-primary mt-6 inline-flex w-full items-center justify-center rounded-lg px-4 py-3 text-sm font-semibold transition-colors"
            >
              {content.ctaLabel}
            </a>
          </article>
        ))
      }
    </div>

    <p class="text-muted mt-6 max-w-3xl text-xs leading-relaxed">
      {content.note}
    </p>
  </div>
</section>
