---
import { Image } from 'astro:assets';
import { Check } from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { ServicesContent } from '../../config/types';

interface Props {
  content: ServicesContent['materials'];
}

const { content } = Astro.props;
---

<section
  id="material"
  class="bg-surface-muted scroll-mt-24 px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
>
  <div
    class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-12 lg:items-center lg:gap-14"
  >
    <div class="relative lg:col-span-5" data-reveal="up">
      <div
        class="bg-accent-soft absolute -inset-3 rotate-1 rounded-[2rem]"
        aria-hidden="true"
      >
      </div>

      <Image
        src={content.image}
        alt={content.imageAlt}
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        loading="lazy"
        decoding="async"
        class="border-border relative aspect-[4/5] w-full rounded-[1.75rem] border object-cover"
      />
    </div>

    <div class="lg:col-span-7" data-reveal="up">
      <SectionHeading
        eyebrow={content.eyebrow}
        title={content.title}
        description={content.description}
      />

      <ul class="mt-8 grid gap-x-6 gap-y-5 sm:grid-cols-2">
        {
          content.items.map((item) => (
            <li class="flex items-start gap-3">
              <span
                class="bg-primary-soft text-primary mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full"
                aria-hidden="true"
              >
                <Check class="size-3.5" />
              </span>

              <div>
                <h3 class="text-foreground text-sm font-semibold">
                  {item.title}
                </h3>
                <p class="text-muted mt-1 text-sm leading-relaxed">
                  {item.description}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <p
        class="border-border text-muted mt-8 border-t pt-5 text-xs leading-relaxed"
      >
        {content.note}
      </p>
    </div>
  </div>
</section>
